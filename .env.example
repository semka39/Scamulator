# ==============================================================================
#                 TEMSHCHIK / SCAMULATOR PRODUCTION ENVIRONMENT (.env)
# ==============================================================================
# Скопируйте этот файл в .env на вашем сервере (или создайте .env рядом с package.json)
# Пример команды: cp .env.example .env
# ==============================================================================

# 1. API Ключ платежной системы Argon Pay (для приема платежей через СБП / Ozon)
ARGON_PAY_API_KEY=""

# 2. Публичный SiteKey для hCaptcha (защита от ботов при регистрации)
# По умолчанию используется тестовый ключ (всегда успешен). Замените на реальный при необходимости:
VITE_HCAPTCHA_SITEKEY="10000000-ffff-ffff-ffff-000000000001"

# 3. Базовый URL вашего развернутого приложения (например: https://my-app.com)
APP_URL=""

# 4. Инициализация демо-данных (true - создать тестовых авторов и темки, false - чистая БД)
SEED_DEMO_DATA="false"

# 5. Режим работы (production / development)
NODE_ENV="production"
